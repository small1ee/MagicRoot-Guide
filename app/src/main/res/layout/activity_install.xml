<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootView"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/install_title"
            android:textColor="@color/text_primary"
            android:textSize="20sp"
            android:textStyle="bold" />

        <LinearLayout style="@style/Callout.Info" android:layout_marginTop="6dp">
            <TextView
                style="@style/CalloutLabel"
                android:text="@string/callout_tip"
                android:textColor="@color/callout_info" />

            <TextView
                style="@style/CalloutBody"
                android:text="@string/install_intro" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvInstallEnv"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_card_alt"
            android:fontFamily="monospace"
            android:padding="12dp"
            android:textColor="@color/accent"
            android:textSize="12sp"
            android:typeface="monospace" />

        <Button
            android:id="@+id/btnPickZip"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/install_pick" />

        <TextView
            android:id="@+id/tvInstallFile"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@color/surface"
            android:padding="10dp"
            android:textColor="@color/text_secondary"
            android:textSize="12.5sp" />

        <Button
            android:id="@+id/btnInstall"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/install_do" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnSoftReboot"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/install_softreboot"
                android:textAllCaps="false" />

            <Button
                android:id="@+id/btnReboot"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:text="@string/install_reboot"
                android:textAllCaps="false" />

        </LinearLayout>

        <Button
            android:id="@+id/btnListModules"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/install_list" />

        <TextView
            android:id="@+id/tvInstallOut"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_card_alt"
            android:fontFamily="monospace"
            android:padding="12dp"
            android:text="@string/install_idle"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            android:typeface="monospace" />

    </LinearLayout>
</ScrollView>
