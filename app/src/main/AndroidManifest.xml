<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- 风险/改机类应用检测需要枚举全部已安装包；Android 11+ 默认只有 <queries> 里可见，
         否则 pm list packages 会漏掉未声明的风险应用（与春秋检测口径不一致）。 -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />
    <!-- 重启日志写入公共 Download/RB-log/：Android 10+ 走 MediaStore 无需权限；
         仅 Android 9 及以下写公共目录需要该权限（限定 maxSdkVersion=28，避免新版多余申请）。 -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />

    <!-- 后台持续采集：前台服务保活 + 通知 + 悬浮窗 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- Android 11+ 包可见性：不声明的话 PackageManager 查不到这些管理器，
         无 root 权限时也就无法判断「系统已 root 但未授权」。与 BranchDetect.MANAGER_PKGS 保持同步。 -->
    <queries>
        <package android:name="me.weishu.kernelsu" />
        <package android:name="com.rifsxd.ksunext" />
        <package android:name="com.sukisu.ultra" />
        <package android:name="com.resukisu.resukisu" />
        <package android:name="com.anatdx.yukisu" />
        <!-- FinaSU 真机实测包名（label = FinaSU，v1.3.2）。漏掉它会导致已 root 的机器被报成「无 su、无管理器」 -->
        <package android:name="me.yuki.fina" />
        <package android:name="com.lyravoid.finasu" />
        <package android:name="io.github.lyravoid.finasu" />
        <package android:name="com.topjohnwu.magisk" />
        <package android:name="io.github.vvb2060.magisk" />
        <package android:name="com.rifsxd.kitsunemask" />
        <package android:name="me.bmax.apatch" />
        <package android:name="me.bmax.folkpatch" />
    </queries>

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.RootGuide">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 后台持续采集：前台服务保活，带常驻通知；可选悬浮窗显示状态/停止 -->
        <service
            android:name=".RebootLogService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <activity
            android:name=".PlanActivity"
            android:exported="false"
            android:parentActivityName=".MainActivity" />

        <activity
            android:name=".RefViewActivity"
            android:exported="false"
            android:parentActivityName=".MainActivity" />

        <activity
            android:name=".ModuleInstallActivity"
            android:exported="false"
            android:label="@string/install_title"
            android:parentActivityName=".MainActivity" />

        <activity
            android:name=".RecoveryActivity"
            android:exported="false"
            android:label="@string/recovery_title"
            android:parentActivityName=".MainActivity" />
    </application>

</manifest>
